#SECTION 5
 n <-100 #100 samples for simulation
 
#Control and treatment group (with the same mean so no effect) 
control_group <- rnorm(n, mean =0, sd =1)
treat_group_no_effect <- rnorm(n, mean =0, sd =1)

#T-test of treatment group with no effect
t_test_treat_group_no_effect <- t.test(treat_group_no_effect, control_group) 
t_test_treat_group_no_effect$p.value

#Simulating 10,000 experiments 
n_sims <-10000
true_effect <-0.5  

p_values <- numeric(n_sims)

for (i in 1:n_sims) {
  
  #Control group
  control_group <- rnorm(n, mean = 0, sd = 1)
  
  #Treatment group WITH a real effect
  treat_group_effect <- rnorm(n, mean = true_effect, sd = 1)
  
  p_values[i] <- t.test(treat_group_effect, control_group)$p.value
  }

#Histogram of p-values
hist(p_values,
     breaks = 30,
     main = "Histogram of p-values (moderate true effect)",
     xlab = "p-value",
     col = "red")

#Empirical power
empirical_power <- mean(p_values < 0.05)
empirical_power








